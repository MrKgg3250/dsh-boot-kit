# Keep the tree LF everywhere: this project is published and used on all three
# platforms, and a CRLF checkout makes every diff noisy.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.tgz binary
# cmd/bat are executed by cmd.exe, which parses LF files incorrectly.
*.cmd text eol=crlf
*.bat text eol=crlf
